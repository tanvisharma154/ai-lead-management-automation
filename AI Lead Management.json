    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "owner@example.com",
        "subject": "=Approve follow-up email: {{ $(\"Lead Form\").item.json.Name }} ({{ $(\"Score and Draft Follow-up\").item.json.output.category }} lead)",
        "message": "=New lead from {{ $(\"Lead Form\").item.json.Name }} at {{ $(\"Lead Form\").item.json.Company }} ({{ $(\"Lead Form\").item.json.Email }}).\nBudget: {{ $(\"Lead Form\").item.json.Budget }}\nScore: {{ $(\"Score and Draft Follow-up\").item.json.output.score }}/100 - {{ $(\"Score and Draft Follow-up\").item.json.output.category }}\nSummary: {{ $(\"Score and Draft Follow-up\").item.json.output.summary }}\n\nDraft email to the customer:\n\n{{ $(\"Score and Draft Follow-up\").item.json.output.follow_up_email }}\n\nApprove to send this email to the customer, or reject to discard it.",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "disapproveLabel": "Reject"
          }
        },
        "options": {}
      },
