              "fieldOptions": {
                "values": [
                  {"option": "Under $1k"},
                  {"option": "$1k - $10k"},
                  {"option": "$10k - $50k"},
                  {"option": "Over $50k"}
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Message",
              "fieldType": "textarea",
              "requiredField": true
            }
          ]
